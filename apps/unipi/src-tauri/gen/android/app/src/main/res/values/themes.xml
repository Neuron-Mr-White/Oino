<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: always dark (UniPi has no light theme),
         dark window background so there is no white flash before the
         WebView paints. -->
    <style name="Theme.unipi_mobile" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/unipi_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
