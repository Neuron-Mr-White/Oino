{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, every platform",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "os:default",
    "log:default",
    "deep-link:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
