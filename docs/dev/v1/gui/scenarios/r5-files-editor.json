{
  "name": "r5-files-editor",
  "backend": "demo",
  "shots": "docs/dev/v1/design/shots/desktop",
  "steps": [
    {"seed_file": {"path": "hello.rs", "content": "fn main() {\n    let x = 1;\n    let _ = x;\n}\n"}},
    {"click": {"id": "nav-files"}},
    {"wait_for": {"label": "hello.rs", "timeout_ms": 15000}},
    {"screenshot": {"name": "01-files-tree"}},
    {"click": {"label": "hello.rs"}},
    {"wait_for": {"label": "let x = 1", "timeout_ms": 15000}},
    {"assert": {"route": "files", "text": "let x = 1"}},
    {"screenshot": {"name": "02-files-open"}},
    {"click": {"id": "files-editor"}},
    {"type_text": {"text": "// edited by driver\n"}},
    {"assert": {"text": "edited by driver"}},
    {"screenshot": {"name": "03-files-dirty"}},
    {"key": {"key": "secondary-s"}},
    {"wait_for": {"text": "Saved", "timeout_ms": 8000}},
    {"screenshot": {"name": "04-files-saved"}},
    {"click": {"label": "README.md"}},
    {"wait_for": {"text": "oino test project", "timeout_ms": 10000}},
    {"click": {"label": "hello.rs"}},
    {"wait_for": {"text": "edited by driver", "timeout_ms": 10000}},
    {"screenshot": {"name": "05-files-reopen"}},
    {"key": {"key": "secondary-k"}},
    {"type_text": {"text": "files page"}},
    {"wait_for": {"text": "Files page", "timeout_ms": 10000}},
    {"screenshot": {"name": "06-palette"}},
    {"click": {"role": "row", "label": "Files page"}},
    {"assert": {"route": "files"}}
  ]
}
