{
  "name": "unipi-memory",
  "backend": "real",
  "shots": "docs/dev/v1/design/shots/desktop",
  "steps": [
    {
      "wait_for": {
        "id": "composer",
        "timeout_ms": 180000
      }
    },
    {
      "type_text": {
        "text": "/memory",
        "submit": true
      }
    },
    {
      "wait_for": {
        "id": "result-ok",
        "timeout_ms": 30000
      }
    },
    {
      "wait_for": {
        "text": "project memories",
        "timeout_ms": 20000
      }
    },
    {
      "screenshot": {
        "name": "01-memory-status"
      }
    },
    {
      "click": {
        "id": "result-ok"
      }
    },
    {
      "type_text": {
        "text": "/memory-search zebra",
        "submit": true
      }
    },
    {
      "wait_for": {
        "text": "No memories found",
        "timeout_ms": 30000
      }
    },
    {
      "screenshot": {
        "name": "02-memory-search"
      }
    },
    {
      "click": {
        "id": "composer"
      }
    },
    {
      "type_text": {
        "text": "Remember one durable fact with the memory_store tool: the project mascot is a pixel crab named Unicrab. Then reply STORED.",
        "submit": true
      }
    },
    {
      "wait_for": {
        "text": "memory_store",
        "timeout_ms": 180000
      }
    },
    {
      "screenshot": {
        "name": "03-store-tool"
      }
    },
    {
      "wait_state": {
        "busy": false,
        "timeout_ms": 180000
      }
    },
    {
      "type_text": {
        "text": "/memory-search Unicrab",
        "submit": true
      }
    },
    {
      "wait_for": {
        "text": "Unicrab",
        "timeout_ms": 60000
      }
    },
    {
      "screenshot": {
        "name": "04-search-found"
      }
    },
    {
      "click": {
        "id": "result-ok"
      }
    },
    {
      "sleep": {
        "ms": 400
      }
    },
    {
      "type_text": {
        "text": "/memory-consolidate",
        "submit": true
      }
    },
    {
      "wait_for": {
        "text": "Consolidating",
        "timeout_ms": 60000
      }
    },
    {
      "screenshot": {
        "name": "05-consolidate"
      }
    },
    {
      "key": {
        "key": "escape"
      }
    },
    {
      "sleep": {
        "ms": 1000
      }
    },
    {
      "screenshot": {
        "name": "06-stopped"
      }
    }
  ]
}
