{
  "name": "r5-tui-removal",
  "scene": "run",
  "backend": "demo",
  "env": ["OINO_DESKTOP_DEMO_PACE=8"],
  "shots": "docs/dev/v1/design/shots/gui",
  "steps": [
    {"wait_for": {"id": "composer", "timeout_ms": 60000}},
    {"wait_state": {"busy": true, "timeout_ms": 30000}},
    {"wait_state": {"chrome": "Ship trailing commas", "timeout_ms": 30000}},
    {"assert": {"chrome_absent": "UNIPI"}},
    {"assert": {"chrome_absent": "Oino"}},
    {"key": {"key": "alt+h"}},
    {"sleep": {"ms": 600}},
    {"assert": {"chrome_absent": "alt+h"}},
    {"assert": {"absent": {"label": "alt+h"}}},
    {"screenshot": {"name": "01-no-hint-strip"}},
    {"click": {"id": "nav-ext"}},
    {"wait_state": {"route": "extensions", "timeout_ms": 20000}},
    {"assert": {"absent": {"label": "unipi.footer"}}},
    {"assert": {"absent": {"label": "unipi.command-enchantment"}}},
    {"assert": {"absent": {"label": "unipi.input-shortcuts"}}},
    {"assert": {"absent": {"label": "unipi.app-bridge"}}},
    {"screenshot": {"name": "02-extensions-page"}},
    {"click": {"id": "nav-sessions"}},
    {"wait_for": {"id": "composer", "timeout_ms": 20000}},
    {"click": {"id": "composer"}},
    {"type_text": {"text": "/", "submit": false}},
    {"wait_for": {"id": "completion-menu", "timeout_ms": 20000}},
    {"assert": {"absent": {"label": "unipi."}}},
    {"screenshot": {"name": "03-completions-no-tags"}},
    {"key": {"key": "secondary-a"}},
    {"key": {"key": "backspace"}}
  ]
}
