{
  "name": "unipi-workflow",
  "backend": "real",
  "shots": "docs/dev/v1/design/shots/desktop",
  "steps": [
    {"wait_for": {"id": "composer", "timeout_ms": 180000}},
    {"wait_for": {"id": "mode-chip", "timeout_ms": 60000}},
    {"assert": {"element": {"id": "mode-chip", "role": "chip"}}},
    {"click": {"id": "mode-chip"}},
    {"wait_for": {"label": "Full access", "timeout_ms": 15000}},
    {"screenshot": {"name": "01-mode-menu"}},
    {"click": {"label": "Full access", "role": "menu_row"}},
    {"wait_state": {"element": {"id": "mode-chip", "label": "Full access"}, "timeout_ms": 20000}},
    {"screenshot": {"name": "02-full-access"}},
    {"type_text": {"text": "/permission ask", "submit": true}},
    {"wait_for": {"text": "Permission mode: ask", "timeout_ms": 20000}},
    {"wait_state": {"element": {"id": "mode-chip", "label": "Ask before changes"}, "timeout_ms": 20000}},
    {"click": {"id": "composer"}},
    {"type_text": {"text": "Run the shell command `echo approval-probe-ok` with the bash tool, then reply DONE.", "submit": true}},
    {"wait_for": {"id": "ap-allow_once", "timeout_ms": 120000}},
    {"assert": {"dialogs": "approval"}},
    {"screenshot": {"name": "03-approval-card"}},
    {"click": {"id": "ap-allow_once"}},
    {"wait_for": {"text": "approval-probe-ok", "timeout_ms": 120000}},
    {"screenshot": {"name": "04-tool-ran"}},
    {"type_text": {"text": "/plan on", "submit": true}},
    {"wait_state": {"element": {"id": "mode-chip", "label": "Plan"}, "timeout_ms": 20000}},
    {"screenshot": {"name": "05-plan-mode"}},
    {"type_text": {"text": "/plan off", "submit": true}},
    {"wait_state": {"element": {"id": "mode-chip", "label": "Ask before changes"}, "timeout_ms": 20000}},
    {"type_text": {"text": "/permission auto", "submit": true}},
    {"wait_state": {"element": {"id": "mode-chip", "label": "Auto"}, "timeout_ms": 20000}},
    {"screenshot": {"name": "06-back-to-auto"}}
  ]
}
