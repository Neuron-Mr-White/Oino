{
  "name": "unipi-app-bridge",
  "backend": "real",
  "shots": "docs/dev/v1/design/shots/desktop",
  "steps": [
    {
      "wait_for": {
        "id": "composer",
        "timeout_ms": 180000
      }
    },
    {
      "type_text": {
        "text": "/app",
        "submit": true
      }
    },
    {
      "wait_state": {
        "open": "side",
        "timeout_ms": 30000
      }
    },
    {
      "wait_for": {
        "id": "unipi.app-bridge/control/tabs-0",
        "timeout_ms": 30000
      }
    },
    {
      "wait_for": {
        "text": "State:",
        "timeout_ms": 20000
      }
    },
    {
      "screenshot": {
        "name": "01-control-centre"
      }
    },
    {
      "click": {
        "id": "unipi.app-bridge/control/tabs-1"
      }
    },
    {
      "wait_state": {
        "element": {
          "id": "unipi.app-bridge/control/tabs-1",
          "selected": true
        },
        "timeout_ms": 20000
      }
    },
    {
      "screenshot": {
        "name": "02-work-tab"
      }
    },
    {
      "click": {
        "id": "unipi.app-bridge/control/tabs-2"
      }
    },
    {
      "wait_state": {
        "element": {
          "id": "unipi.app-bridge/control/tabs-2",
          "selected": true
        },
        "timeout_ms": 20000
      }
    },
    {
      "screenshot": {
        "name": "03-modes-tab"
      }
    },
    {
      "click": {
        "id": "unipi.app-bridge/control/tabs-4"
      }
    },
    {
      "wait_state": {
        "element": {
          "id": "unipi.app-bridge/control/tabs-4",
          "selected": true
        },
        "timeout_ms": 20000
      }
    },
    {
      "screenshot": {
        "name": "04-info-tab"
      }
    },
    {
      "click": {
        "id": "side-hide"
      }
    },
    {
      "sleep": {
        "ms": 500
      }
    },
    {
      "screenshot": {
        "name": "05-side-hidden"
      }
    }
