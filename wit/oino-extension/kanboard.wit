package oino:extension@1.0.0;

interface kanboard {
    use types.{json, host-error};
    /// Runs an `oino-kanboard` command in the host process and returns its
    /// `--json` payload (round-5 #7: the board daemon is gone; the host holds
    /// the library). `request` is `{argv: [string], env?: {string: string},
    /// cwd?: string, stdin?: string}` — the same argv/env/cwd/stdin the
    /// `oino-kanboard` binary takes (`env` aliases the `OINO_KANBOARD_*` global
    /// flags; `cwd` defaults to the session cwd; the board home defaults to
    /// the host agent dir). Rule/usage failures come back in the payload as
    /// `{ok: false, error, kind}`; only malformed requests fail the call.
    exec: func(request: json) -> result<json, host-error>;
}
