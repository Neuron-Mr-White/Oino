{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oino.dev/schemas/ui/2/node.schema.json",
  "title": "Oino UI protocol v2 node",
  "$ref": "#/$defs/Node",
  "$defs": {
    "Key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ActionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
    },
    "Color": {
      "enum": [
        "reset",
        "text",
        "muted",
        "dim",
        "accent",
        "primary",
        "info",
        "link",
        "success",
        "warning",
        "error",
        "harness",
        "thinking",
        "tool",
        "user",
        "assistant",
        "code",
        "border",
        "borderAccent",
        "borderMuted",
        "c1",
        "c2",
        "c3",
        "c4",
        "c5",
        "c6",
        "c7",
        "c8",
        "c9",
        "c10",
        "c11",
        "c12",
        "surface1",
        "surface2",
        "surface3",
        "selectedBg",
        "successBg",
        "errorBg",
        "warningBg",
        "infoBg",
        "accentBg",
        "diffAdded",
        "diffRemoved",
        "diffContext"
      ]
    },
    "Icon": {
      "enum": [
        "check",
        "x",
        "dot",
        "warn",
        "info",
        "clock",
        "gear",
        "branch",
        "bolt",
        "bot",
        "folder",
        "file",
        "search",
        "cloud",
        "lock",
        "board",
        "terminal",
        "globe",
        "diff",
        "list",
        "chart",
        "play",
        "pause",
        "stop",
        "refresh",
        "plus",
        "trash"
      ]
    },
    "Modifier": {
      "enum": [
        "BOLD",
        "DIM",
        "ITALIC",
        "UNDERLINED",
        "SLOW_BLINK",
        "RAPID_BLINK",
        "REVERSED",
        "HIDDEN",
        "CROSSED_OUT"
      ]
    },
    "Alignment": {
      "enum": [
        "Left",
        "Center",
        "Right"
      ]
    },
    "Style": {
      "type": "object",
      "properties": {
        "fg": {
          "$ref": "#/$defs/Color"
        },
        "bg": {
          "$ref": "#/$defs/Color"
        },
        "underlineColor": {
          "$ref": "#/$defs/Color"
        },
        "addModifier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modifier"
          }
        },
        "subModifier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modifier"
          }
        }
      }
    },
    "Span": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "style": {
              "$ref": "#/$defs/Style"
            },
            "link": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "content"
          ]
        }
      ]
    },
    "Line": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          }
        },
        {
          "type": "object",
          "properties": {
            "spans": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Span"
              }
            },
            "style": {
              "$ref": "#/$defs/Style"
            },
            "alignment": {
              "$ref": "#/$defs/Alignment"
            }
          },
          "required": [
            "spans"
          ]
        }
      ]
    },
    "Text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          }
        },
        {
          "type": "object",
          "properties": {
            "lines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Line"
              }
            },
            "style": {
              "$ref": "#/$defs/Style"
            },
            "alignment": {
              "$ref": "#/$defs/Alignment"
            }
          },
          "required": [
            "lines"
          ]
        }
      ]
    },
    "Constraint": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        {
          "type": "object",
          "properties": {
            "Length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "Length"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "Percentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "Percentage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "Ratio": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "Ratio"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "Min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "Min"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "Max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "Max"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "Fill": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "Fill"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Padding": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "right": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      ]
    },
    "Borders": {
      "oneOf": [
        {
          "enum": [
            "ALL",
            "NONE"
          ]
        },
        {
          "type": "array",
          "items": {
            "enum": [
              "TOP",
              "RIGHT",
              "BOTTOM",
              "LEFT"
            ]
          },
          "uniqueItems": true
        }
      ]
    },
    "Title": {
      "oneOf": [
        {
          "$ref": "#/$defs/Line"
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/Line"
            },
            "alignment": {
              "$ref": "#/$defs/Alignment"
            },
            "position": {
              "enum": [
                "Top",
                "Bottom"
              ]
            }
          },
          "required": [
            "content"
          ]
        }
      ]
    },
    "BlockProps": {
      "type": "object",
      "properties": {
        "title": {
          "oneOf": [
            {
              "$ref": "#/$defs/Line"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Title"
              }
            }
          ]
        },
        "titleAlignment": {
          "$ref": "#/$defs/Alignment"
        },
        "borders": {
          "$ref": "#/$defs/Borders"
        },
        "borderType": {
          "enum": [
            "Plain",
            "Rounded",
            "Double",
            "Thick"
          ]
        },
        "borderStyle": {
          "$ref": "#/$defs/Style"
        },
        "titleStyle": {
          "$ref": "#/$defs/Style"
        },
        "padding": {
          "$ref": "#/$defs/Padding"
        },
        "collapsible": {
          "type": "boolean"
        },
        "collapsed": {
          "type": "boolean"
        },
        "rail": {
          "$ref": "#/$defs/Color"
        },
        "style": {
          "$ref": "#/$defs/Style"
        }
      }
    },
    "Common": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/Key"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "block": {
          "$ref": "#/$defs/BlockProps"
        },
        "fallback": {
          "$ref": "#/$defs/Node"
        }
      }
    },
    "ImageSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "string",
              "contentEncoding": "base64"
            },
            "mimeType": {
              "type": "string"
            }
          },
          "required": [
            "data",
            "mimeType"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "blob": {
              "type": "string"
            }
          },
          "required": [
            "blob"
          ]
        }
      ]
    },
    "ListItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/Key"
            },
            "content": {
              "$ref": "#/$defs/Text"
            },
            "style": {
              "$ref": "#/$defs/Style"
            },
            "detail": {
              "$ref": "#/$defs/Line"
            },
            "badge": {
              "$ref": "#/$defs/Line"
            },
            "icon": {
              "$ref": "#/$defs/Icon"
            },
            "disabled": {
              "type": "boolean"
            }
          },
          "required": [
            "content"
          ]
        }
      ]
    },
    "Cell": {
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/Text"
            },
            "style": {
              "$ref": "#/$defs/Style"
            }
          },
          "required": [
            "content"
          ]
        }
      ]
    },
    "Row": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/Key"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cell"
          }
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bottomMargin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "style": {
          "$ref": "#/$defs/Style"
        }
      },
      "required": [
        "cells"
      ]
    },
    "TreeNode": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/Key"
        },
        "label": {
          "$ref": "#/$defs/Line"
        },
        "icon": {
          "$ref": "#/$defs/Icon"
        },
        "badge": {
          "$ref": "#/$defs/Line"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeNode"
          }
        },
        "expanded": {
          "type": "boolean"
        },
        "lazy": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label"
      ]
    },
    "Axis": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/Line"
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          }
        },
        "labelsAlignment": {
          "$ref": "#/$defs/Alignment"
        },
        "style": {
          "$ref": "#/$defs/Style"
        }
      },
      "required": [
        "bounds"
      ]
    },
    "Dataset": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Line"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "marker": {
          "enum": [
            "Dot",
            "Braille",
            "Block",
            "Bar",
            "HalfBlock"
          ]
        },
        "graphType": {
          "enum": [
            "Scatter",
            "Line",
            "Bar"
          ]
        },
        "style": {
          "$ref": "#/$defs/Style"
        }
      },
      "required": [
        "data"
      ]
    },
    "Bar": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "$ref": "#/$defs/Line"
        },
        "textValue": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "valueStyle": {
          "$ref": "#/$defs/Style"
        }
      },
      "required": [
        "value"
      ]
    },
    "BarGroup": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/Line"
        },
        "bars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bar"
          }
        }
      },
      "required": [
        "bars"
      ]
    },
    "Hint": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ActionId"
        }
      },
      "required": [
        "keys",
        "label"
      ]
    },
    "Option": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Line"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ]
    },
    "ListState": {
      "type": "object",
      "properties": {
        "selected": {
          "oneOf": [
            {
              "$ref": "#/$defs/Key"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Key"
              }
            }
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Layout": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "Layout"
            },
            "direction": {
              "enum": [
                "Vertical",
                "Horizontal"
              ]
            },
            "constraints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Constraint"
              },
              "maxItems": 64
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "maxItems": 64
            },
            "spacing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "margin": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                {
                  "type": "object",
                  "properties": {
                    "horizontal": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "vertical": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    }
                  }
                }
              ]
            },
            "flex": {
              "enum": [
                "Legacy",
                "Start",
                "End",
                "Center",
                "SpaceBetween",
                "SpaceAround"
              ]
            },
            "collapse": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "t",
            "children"
          ]
        }
      ]
    },
    "Block": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "Block"
            },
            "title": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Line"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Title"
                  }
                }
              ]
            },
            "titleAlignment": {
              "$ref": "#/$defs/Alignment"
            },
            "borders": {
              "$ref": "#/$defs/Borders"
            },
            "borderType": {
              "enum": [
                "Plain",
                "Rounded",
                "Double",
                "Thick"
              ]
            },
            "borderStyle": {
              "$ref": "#/$defs/Style"
            },
            "titleStyle": {
              "$ref": "#/$defs/Style"
            },
            "padding": {
              "$ref": "#/$defs/Padding"
            },
            "collapsible": {
              "type": "boolean"
            },
            "collapsed": {
              "type": "boolean"
            },
            "rail": {
              "$ref": "#/$defs/Color"
            },
            "style": {
              "$ref": "#/$defs/Style"
            },
            "child": {
              "$ref": "#/$defs/Node"
            },
            "onToggle": {
              "$ref": "#/$defs/ActionId"
            }
          },
          "required": [
            "t"
          ]
        }
      ]
    },
    "Paragraph": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "Paragraph"
            },
            "text": {
              "$ref": "#/$defs/Text"
            },
            "wrap": {
              "oneOf": [
                {
                  "const": false
                },
                {
                  "type": "object",
                  "properties": {
                    "trim": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            },
            "scroll": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "minItems": 2,
              "maxItems": 2
            },
            "alignment": {
              "$ref": "#/$defs/Alignment"
            },
            "scrollbar": {
              "type": "boolean"
            }
          },
          "required": [
            "t",
            "text"
          ]
        }
      ]
    },
    "List": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "List"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ListItem"
              },
              "maxItems": 5000
            },
            "state": {
              "$ref": "#/$defs/ListState"
            },
            "highlightStyle": {
              "$ref": "#/$defs/Style"
            },
            "highlightSymbol": {
              "type": "string"
            },
            "repeatHighlightSymbol": {
              "type": "boolean"
            },
            "highlightSpacing": {
              "enum": [
                "Always",
                "WhenSelected",
                "Never"
              ]
            },
            "direction": {
              "enum": [
                "TopToBottom",
                "BottomToTop"
              ]
            },
            "scrollPadding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "multi": {
              "type": "boolean"
            },
            "scrollbar": {
              "type": "boolean"
            },
            "onSelect": {
              "$ref": "#/$defs/ActionId"
            },
            "onActivate": {
              "$ref": "#/$defs/ActionId"
            }
          },
          "required": [
            "t",
            "items"
          ]
        }
      ]
    },
    "Table": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "Table"
            },
            "header": {
              "$ref": "#/$defs/Row"
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Row"
              },
              "maxItems": 5000
            },
            "footer": {
              "$ref": "#/$defs/Row"
            },
            "widths": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Constraint"
              }
            },
            "columnSpacing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "rowHighlightStyle": {
              "$ref": "#/$defs/Style"
            },
            "highlightSymbol": {
              "type": "string"
            },
            "highlightSpacing": {
              "enum": [
                "Always",
                "WhenSelected",
                "Never"
              ]
            },
            "state": {
              "$ref": "#/$defs/ListState"
            },
            "sticky": {
              "enum": [
                "FirstColumn"
              ]
            },
            "scrollbar": {
              "type": "boolean"
            },
            "onSelect": {
              "$ref": "#/$defs/ActionId"
            },
            "onActivate": {
              "$ref": "#/$defs/ActionId"
            }
          },
          "required": [
            "t",
            "rows",
            "widths"
          ]
        }
      ]
    },
    "Tabs": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "Tabs"
            },
            "titles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/$defs/Key"
