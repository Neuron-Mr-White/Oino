{
  "apiVersion": "oino.extension/2",
  "id": "unipi.subagents",
  "name": "Subagents",
  "version": "3.0.0",
  "kind": "extension",
  "description": "Hand self-contained tasks to independent child agents (foreground, background, resume).",
  "license": "MIT",
  "resources": {
    "skills": [
      "skills"
    ]
  },
  "permissions": {
    "process": {
      "spawn": true,
      "allow": [
        "*"
      ]
    },
    "agents": {
      "spawn": true,
      "maxDepth": 2
    },
    "fs": {
      "project": "write"
    },
    "sessionControl": true,
    "services": {
      "call": [
        "unipi.core/core.open-tray",
        "*/subagent-reader.read"
      ]
    }
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:f3c6bc0c09dbb75337d235323f54fcd04cea1ac21ae2b6e9f7b5f2abfe09fbbc"
  }
}