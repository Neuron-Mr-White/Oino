{
  "apiVersion": "oino.extension/2",
  "id": "unipi.background-tasks",
  "name": "Background tasks",
  "version": "3.0.0",
  "kind": "extension",
  "description": "Run shell commands in the background and wake the agent when they finish.",
  "license": "MIT",
  "permissions": {
    "process": {
      "spawn": true,
      "allow": [
        "*"
      ]
    },
    "sessionControl": true,
    "services": {
      "call": [
        "unipi.core/core.open-tray",
        "unipi.subagents/subagents.cancel"
      ]
    }
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:09b6291dcfa68b3fae28fcb6d954db4265fc140964eb7190bb4c6c42a5df67be"
  }
}