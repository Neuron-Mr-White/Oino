{
  "apiVersion": "oino.extension/2",
  "id": "unipi.long-horizon",
  "name": "Long-horizon",
  "version": "3.0.0",
  "kind": "extension",
  "description": "Multi-turn autonomous work: goal, ralph checklist loops, swarm and graph owners with an independent verifier.",
  "license": "MIT",
  "ui": {
    "reserved": [
      "unipi.long-horizon/visualize"
    ]
  },
  "limits": {
    "hookTimeoutMs": 90000
  },
  "permissions": {
    "sessionControl": true,
    "models": {
      "complete": true
    },
    "credentials": [
      "*"
    ],
    "fs": {
      "project": "write"
    },
    "network": {
      "hosts": [
        "openrouter.ai",
        "api.typesafe.ai"
      ]
    },
    "env": [
      "TYPESAFE_API_KEY",
      "OPENROUTER_API_KEY"
    ],
    "secrets": true,
    "osNotify": true,
    "services": {
      "call": [
        "unipi.subagents/*",
        "*/evidence.contribute"
      ]
    }
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:f0869e5816940d7512bcf643fef3db16af7e88d7e022c1bdaf0bf1ceb6cd3a3d"
  }
}