        "api.github.com",
        "github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com"
      ]
    },
    "fs": {
      "agentDir": "read"
    }
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:523c988cb8832c0ec702a87c0816c94526649b0d0d5a398dd318a6dc40b205ec"
  }
}