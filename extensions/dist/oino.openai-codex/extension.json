{
  "apiVersion": "oino.extension/2",
  "id": "oino.openai-codex",
  "name": "OpenAI Codex (ChatGPT sign-in)",
  "version": "1.0.0",
  "kind": "provider",
  "description": "OpenAI Codex Responses wire over a ChatGPT Plus/Pro subscription with browser and device-code OAuth (SSE transport).",
  "license": "MIT",
  "provides": {
    "apis": [
      "openai-codex-responses"
    ],
    "providers": [
      "openai-codex"
    ]
  },
  "permissions": {
    "network": {
      "hosts": [
        "*",
        "chatgpt.com",
        "auth.openai.com"
      ],
      "listenLoopback": true
    },
    "env": [
      "OINO_CACHE_RETENTION",
      "PI_CACHE_RETENTION"
    ],
    "openUrl": true
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:34d03807bdd87baf8fdb651c5d560418a4b98e61097abdb288d4873b3dc2c838"
  }
}