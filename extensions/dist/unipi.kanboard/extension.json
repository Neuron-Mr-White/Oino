{
  "apiVersion": "oino.extension/2",
  "id": "unipi.kanboard",
  "name": "Kanboard",
  "version": "3.0.0",
  "kind": "extension",
  "description": "A persistent task board per project: /kanboard (open the board panel, onboard, status, show, doctor), -add and host-dispatched Superagent workers; a write guard on the agent's unipi-kanboard calls, a settle monitor that nudges unfinished claims, progress reminders and transcript badges.",
  "license": "MIT",
  "ui": {
    "reserved": [
      "unipi.kanboard/board"
    ]
  },
  "binaries": [
    "unipi-kanboard"
  ],
  "resources": {
    "skills": [
      "skills"
    ]
  },
  "permissions": {
    "sessionControl": true,
    "process": {
      "spawn": true,
      "allow": [
        "unipi-kanboard",
        "tailscale"
      ],
      "detached": true
    },
    "network": {
      "hosts": [
        "127.0.0.1",
        "localhost"
      ]
    },
    "env": [
      "UNIPI_KANBOARD_BIN",
      "UNIPI_KANBOARD_CHILD",
      "UNIPI_KANBOARD_HOME"
    ]
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:61ece04736bb6d6f208b1243b07de80d9f8bbb1d08f3d109462b6e6915720ee0",
    "bin/unipi-kanboard": "sha256:567113909115916b6ca8f665d6cfa86e098e0c1dab91b636045365e5d65d8608"
  }
}