{
  "apiVersion": "oino.extension/2",
  "id": "unipi.kanboard",
  "name": "Kanboard",
  "version": "3.0.0",
  "kind": "extension",
  "description": "A persistent task board per project: /kanboard (open the board panel, onboard, status, show, doctor), -add and host-dispatched Superagent workers; a write guard on the agent's unipi-kanboard calls, a settle monitor that nudges unfinished claims, progress reminders and transcript badges.",
  "license": "MIT",
  "ui": {
    "reserved": [
      "unipi.kanboard/board"
    ]
  },
  "binaries": [
    "unipi-kanboard"
  ],
  "resources": {
    "skills": [
      "skills"
    ]
  },
  "permissions": {
    "sessionControl": true,
    "process": {
      "spawn": true,
      "allow": [
        "unipi-kanboard",
        "tailscale"
      ],
      "detached": true
    },
    "network": {
      "hosts": [
        "127.0.0.1",
        "localhost"
      ]
    },
    "env": [
      "UNIPI_KANBOARD_BIN",
      "UNIPI_KANBOARD_CHILD",
      "UNIPI_KANBOARD_HOME"
    ]
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:f40bf08ef51529abdc5e99883ab2e6c5d656296184e6ad9dc596e38b19bdb084",
    "bin/unipi-kanboard": "sha256:aa09162e216b742d97957992a6f1629134ad567f1ac870836b6b37b61a2a02e9"
  }
}