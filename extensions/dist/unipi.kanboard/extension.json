{
  "apiVersion": "oino.extension/2",
  "id": "unipi.kanboard",
  "name": "Kanboard",
  "version": "3.0.0",
  "kind": "extension",
  "description": "A persistent task board per project: /kanboard (open the board panel, onboard, status, show, doctor), -add and host-dispatched Superagent workers; a write guard on the agent's unipi-kanboard calls, a settle monitor that nudges unfinished claims, progress reminders and transcript badges.",
  "license": "MIT",
  "ui": {
    "reserved": [
      "unipi.kanboard/board"
    ]
  },
  "binaries": [
    "unipi-kanboard"
  ],
  "helpers": {
    "unipi-kanboard": [
      [
        "project",
        "show",
        "--json"
      ],
      [
        "project",
        "list",
        "--json"
      ],
      [
        "status",
        "--json"
      ],
      [
        "list",
        "--json"
      ],
      [
        "list",
        "--all",
        "--json"
      ]
    ]
  },
  "resources": {
    "skills": [
      "skills"
    ]
  },
  "permissions": {
    "sessionControl": true,
    "process": {
      "spawn": true,
      "allow": [
        "unipi-kanboard",
        "tailscale"
      ],
      "detached": true
    },
    "network": {
      "hosts": [
        "127.0.0.1",
        "localhost"
      ]
    },
    "env": [
      "UNIPI_KANBOARD_BIN",
      "UNIPI_KANBOARD_CHILD",
      "UNIPI_KANBOARD_HOME"
    ]
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:98a936b30cfc872c4a5020580d1aedb4f958a283a41907a2aec5348dc677581b",
    "bin/unipi-kanboard": "sha256:70433329adfc6a017420cc697401d1841f74f7721629b42bcc270c2fd652c3f3"
  }
}