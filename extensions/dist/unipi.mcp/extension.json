{
  "apiVersion": "oino.extension/2",
  "id": "unipi.mcp",
  "name": "MCP",
  "version": "3.0.0",
  "kind": "extension",
  "description": "Connects MCP servers (stdio and streamable HTTP) and registers their tools as <server>__<tool>; server registry, catalog browser and status.",
  "license": "MIT",
  "provides": {
    "apis": [
      "mcp"
    ]
  },
  "resources": {
    "skills": [
      "skills"
    ]
  },
  "permissions": {
    "process": {
      "spawn": true,
      "allow": [
        "*"
      ]
    },
    "network": {
      "hosts": [
        "*"
      ]
    },
    "fs": {
      "project": "read",
      "agentDir": "read"
    },
    "secrets": true,
    "env": [
      "HOME",
      "USERPROFILE"
    ]
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:0f8f5af54b1fbeccaea606fdd051f6af94aa6137c435be2f50e2797da93f93d9"
  }
}