{
  "apiVersion": "oino.extension/2",
  "id": "oino.bedrock",
  "name": "Amazon Bedrock",
  "version": "1.0.0",
  "kind": "provider",
  "description": "Amazon Bedrock ConverseStream wire: bearer tokens or IAM credentials (env or ~/.aws profiles) with SigV4.",
  "license": "MIT",
  "provides": {
    "apis": [
      "bedrock-converse-stream"
    ],
    "providers": [
      "amazon-bedrock"
    ]
  },
  "permissions": {
    "network": {
      "hosts": [
        "*",
        "*.amazonaws.com",
        "*.amazonaws.com.cn"
      ]
    },
    "env": [
      "OINO_CACHE_RETENTION",
      "PI_CACHE_RETENTION",
      "AWS_REGION",
      "AWS_DEFAULT_REGION",
      "AWS_PROFILE",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "AWS_SESSION_TOKEN",
      "AWS_BEARER_TOKEN_BEDROCK",
      "AWS_BEDROCK_SKIP_AUTH",
      "AWS_BEDROCK_FORCE_CACHE",
      "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
      "AWS_CONTAINER_CREDENTIALS_FULL_URI",
      "AWS_WEB_IDENTITY_TOKEN_FILE"
    ],
    "fs": {
      "paths": [
        {
          "path": "~/.aws",
          "access": "read",
          "alias": "aws"
        }
      ]
    }
  },
  "component": "component.wasm",
  "checksums": {
    "component.wasm": "sha256:b7666882b8ea74beb6773d8f7e86a149535458d8db63c87de46309577d425f69"
  }
}