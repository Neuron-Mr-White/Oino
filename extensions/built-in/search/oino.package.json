{
  "id": "oino.search",
  "display_name": "Oino Search",
  "version": "0.1.0",
  "oino": "^0.1",
  "publisher": "oino",
  "description": "Deferred grep/find tools over the project tree (gitignore-aware), loaded on demand via tool_search.",
  "extensions": [
    {
      "manifest": "extensions/search/oino.extension.json",
      "enabled_by_default": true
    }
  ],
  "resources": [],
  "assets": [],
  "examples": [],
  "docs": [{"path": "docs/README.md"}],
  "dependencies": [],
  "permissions": {
    "tools": ["grep", "find"],
    "commands": [],
    "host_capabilities": [],
    "ui": [],
    "filesystem": [{"access": "read", "paths": ["${project}"]}],
    "shell_process": {"allowed": false, "commands": []},
    "network": {"raw_network": false, "hosts": []},
    "secrets": [],
    "session_persistence": [],
    "provider_mutation": [],
    "package_management": []
  },
  "trust": {"reviewed": true, "publisher": "oino", "advisories": []}
}
