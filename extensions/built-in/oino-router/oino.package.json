{
  "id": "oino.oino_router",
  "display_name": "Oino Router",
  "version": "0.1.0",
  "oino": "^0.1",
  "publisher": "oino",
  "description": "Official Oino Router provider (router.oino.dev) \u2014 Anthropic Messages or OpenAI chat-completions per model.",
  "extensions": [
    {
      "manifest": "extensions/oino-router/oino.extension.json",
      "enabled_by_default": true
    }
  ],
  "resources": [],
  "assets": [],
  "examples": [],
  "docs": [
    {
      "path": "docs/README.md"
    }
  ],
  "dependencies": [],
  "permissions": {
    "tools": [],
    "commands": [],
    "host_capabilities": [],
    "ui": [],
    "filesystem": [],
    "shell_process": {
      "allowed": false,
      "commands": []
    },
    "network": {
      "raw_network": false,
      "hosts": [
        "router.oino.dev"
      ],
      "hosts_from_config": [
        "base_url"
      ]
    },
    "secrets": [
      "OINO_API_KEY",
      "OMNI_API_KEY"
    ],
    "session_persistence": [],
    "provider_mutation": [],
    "package_management": []
  },
  "trust": {
    "reviewed": true,
    "publisher": "oino",
    "advisories": []
  }
}
