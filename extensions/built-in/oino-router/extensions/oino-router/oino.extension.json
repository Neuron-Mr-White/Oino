{
  "id": "oino.oino_router",
  "package_id": "oino.oino_router",
  "display_name": "Oino Router",
  "version": "0.1.0",
  "oino": "^0.1",
  "protocol": 1,
  "runtime": {
    "kind": "wasm",
    "entry": "plugin.wasm",
    "abi": "oino:extension@0.1.0"
  },
  "config_env": {
    "base_url": "OINO_BASE_URL",
    "format": "OINO_FORMAT"
  },
  "permissions": {
    "tools": [],
    "commands": [],
    "host_capabilities": [],
    "ui": [],
    "filesystem": [],
    "shell_process": {
      "allowed": false,
      "commands": []
    },
    "network": {
      "raw_network": false,
      "hosts": [
        "router.oino.dev"
      ],
      "hosts_from_config": [
        "base_url"
      ]
    },
    "secrets": [
      "OINO_API_KEY",
      "OMNI_API_KEY"
    ],
    "session_persistence": [],
    "provider_mutation": [],
    "package_management": []
  },
  "contributes": {
    "providers": [
      {
        "id": "provider.oino",
        "provider_id": "oino",
        "display_name": "Oino Router",
        "model_ids": [],
        "privacy": {
          "can_receive_prompts": true,
          "can_receive_tools": true,
          "can_mutate_requests": false
        }
      }
    ],
    "commands": [],
    "tools": [],
    "keymaps": [],
    "hooks": [],
    "ui_surfaces": [],
    "settings_pages": [],
    "themes": [],
    "resources": [],
    "persistence": [],
    "autosuggest_providers": [],
    "renderers": []
  },
  "metadata": {
    "oino_builtin_optional": true,
    "runtime_contract": "Official Oino Router provider (router.oino.dev) over Anthropic Messages or OpenAI chat-completions per model."
  }
}
