{
  "id": "oino.budget",
  "package_id": "oino.budget",
  "display_name": "Oino Budget",
  "version": "0.1.0",
  "oino": "^0.1",
  "protocol": 1,
  "runtime": {
    "kind": "wasm",
    "entry": "plugin.wasm",
    "abi": "oino:extension@0.1.0"
  },
  "permissions": {
    "tools": [],
    "commands": [],
    "host_capabilities": [],
    "ui": [],
    "filesystem": [],
    "shell_process": {
      "allowed": false,
      "commands": []
    },
    "network": {
      "raw_network": false,
      "hosts": []
    },
    "secrets": [],
    "session_persistence": [
      "project"
    ],
    "provider_mutation": [],
    "package_management": []
  },
  "contributes": {
    "tools": [],
    "commands": [],
    "hooks": [
      {
        "id": "budget.agent_start",
        "event": "agent_start",
        "mode": "observe",
        "handler": "agent_start",
        "priority": 0,
        "conflict": {
          "strategy": "namespaced",
          "priority": 0,
          "allow_user_override": true
        }
      },
      {
        "id": "budget.turn_end",
        "event": "turn_end",
        "mode": "mutable",
        "priority": 0,
        "conflict": {
          "strategy": "namespaced",
          "priority": 0,
          "allow_user_override": true
        },
        "handler": "turn_end"
      }
    ],
    "providers": [],
    "resources": [],
    "keymaps": [],
    "ui_surfaces": [],
    "settings_pages": [],
    "themes": [],
    "persistence": [],
    "autosuggest_providers": [],
    "renderers": []
  },
  "metadata": {}
}