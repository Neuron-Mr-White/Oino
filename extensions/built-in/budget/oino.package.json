{
  "id": "oino.budget",
  "display_name": "Oino Budget",
  "version": "0.1.0",
  "oino": "^0.1",
  "publisher": "oino",
  "description": "Run caps for turns, cost, wall time and consecutive tool errors, with an optional summary turn before ending the run.",
  "extensions": [
    {
      "manifest": "extensions/budget/oino.extension.json",
      "enabled_by_default": true
    }
  ],
  "resources": [],
  "assets": [],
  "examples": [],
  "docs": [{"path": "docs/README.md"}],
  "dependencies": [],
  "permissions": {
    "tools": [],
    "commands": [],
    "host_capabilities": [],
    "ui": [],
    "filesystem": [],
    "shell_process": {"allowed": false, "commands": []},
    "network": {"raw_network": false, "hosts": []},
    "secrets": [],
    "session_persistence": ["project"],
    "provider_mutation": [],
    "package_management": []
  },
  "trust": {"reviewed": true, "publisher": "oino", "advisories": []}
}
