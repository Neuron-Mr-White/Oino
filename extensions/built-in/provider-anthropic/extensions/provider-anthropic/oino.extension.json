{
  "id": "oino.provider_anthropic",
  "package_id": "oino.provider_anthropic",
  "display_name": "Oino Anthropic Provider",
  "version": "0.1.0",
  "oino": "^0.1",
  "protocol": 1,
  "runtime": {
    "kind": "built_in"
  },
  "permissions": {
    "tools": [],
    "commands": [],
    "host_capabilities": [],
    "ui": [],
    "filesystem": [],
    "shell_process": {
      "allowed": false,
      "commands": []
    },
    "network": {
      "raw_network": false,
      "hosts": [
        "api.anthropic.com"
      ]
    },
    "secrets": [
      "ANTHROPIC_API_KEY"
    ],
    "session_persistence": [],
    "provider_mutation": [],
    "package_management": []
  },
  "contributes": {
    "commands": [],
    "providers": [
      {
        "id": "provider.anthropic",
        "provider_id": "anthropic",
        "display_name": "Anthropic",
        "model_ids": [],
        "privacy": {
          "can_receive_prompts": true,
          "can_receive_tools": true,
          "can_mutate_requests": true
        },
        "runtime": {
          "protocol": "anthropic_messages",
          "base_url": "https://api.anthropic.com",
          "api_key": {
            "kind": "env_var",
            "name": "ANTHROPIC_API_KEY"
          },
          "model_id": "strip_provider_prefix",
          "config": {
            "base_url_key": "base_url",
            "base_url_env": ["ANTHROPIC_BASE_URL"]
          }
        }
      }
    ],
    "resources": [],
    "tools": [],
    "keymaps": [],
    "hooks": [],
    "ui_surfaces": [],
    "settings_pages": [],
    "themes": [],
    "persistence": [],
    "autosuggest_providers": [],
    "renderers": []
  },
  "metadata": {
    "oino_builtin_optional": true,
    "runtime_contract": "Declarative provider `anthropic` is served by the bundled provider-anthropic WASM component when providers.runtime = \"wasm\". Under the native runtime the provider reports a readiness diagnostic."
  }
}
