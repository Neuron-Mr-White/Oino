{
  "apiVersion": "oino.extension/2",
  "id": "unipi.workflow",
  "name": "Workflow",
  "version": "3.0.0",
  "kind": "extension",
  "description": "Read-only Plan mode and historical workflow rendering. Autonomy and approvals are enforced by the host.",
  "license": "MIT",
  "permissions": {
    "fs": { "project": "write" },
    "sessionControl": true,
    "network": { "hosts": ["openrouter.ai", "api.typesafe.ai"] },
    "env": ["TMPDIR", "TYPESAFE_API_KEY", "OPENROUTER_API_KEY"],
    "secrets": true,
    "credentials": ["openrouter"]
  }
}
