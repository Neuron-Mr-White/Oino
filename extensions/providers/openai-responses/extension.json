{
  "apiVersion": "oino.extension/1",
  "id": "oino.openai-responses",
  "name": "OpenAI Responses",
  "version": "1.0.0",
  "kind": "provider",
  "description": "OpenAI Responses wire for OpenAI (API key or Sign in with ChatGPT), xAI and Meta, and for openai-responses models of GitHub Copilot and Cloudflare AI Gateway (pi-ai 1.4.0 port).",
  "license": "MIT",
  "provides": {
    "apis": [
      "openai-responses"
    ],
    "providers": [
      "meta",
      "openai",
      "xai"
    ]
  },
  "permissions": {
    "network": {
      "hosts": [
        "*",
        "api.meta.ai",
        "api.openai.com",
        "api.x.ai",
        "auth.openai.com",
        "api.individual.githubcopilot.com",
        "api.business.githubcopilot.com",
        "api.enterprise.githubcopilot.com",
        "gateway.ai.cloudflare.com",
        "api.cloudflare.com"
      ],
      "listenLoopback": true
    },
    "env": [
      "OINO_CACHE_RETENTION",
      "PI_CACHE_RETENTION",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_GATEWAY_ID"
    ],
    "openUrl": true
  }
}
